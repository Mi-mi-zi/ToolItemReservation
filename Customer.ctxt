comment0.text=\r\n\ Represents\ a\ custome\ rin\ the\ shop\ system\r\n\ stores\ personal\ details\ such\ as\ name,\ title\ and\ a\ unique\ customer\ ID\r\n\r\n\ @author\ (your\ name)\r\n\ @version\ (a\ version\ number\ or\ a\ date)\r\n
comment1.params=surname\ firstName\ otherInitials\ title
